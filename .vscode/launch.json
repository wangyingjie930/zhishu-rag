{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: RAG Platform API",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/apps/api/.venv/bin/python",
            "module": "uvicorn",
            "args": [
                "rag_platform.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8001"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}/apps/api",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/apps/api/src"
            },
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
